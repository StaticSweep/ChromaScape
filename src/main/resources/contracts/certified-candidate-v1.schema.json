{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "certified-candidate/v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "identity", "candidate", "key_id", "base_commit", "source_snapshot_id", "source_manifest_hash", "baseline_fail_manifest_hash", "patch_hash", "proposal_hash", "approval_hash", "post_patch_test_result_hash", "jar_name", "jar_size", "jar_sha256", "sbom_name", "sbom_size", "sbom_sha256", "certification_document_hash", "build_commands", "control_allowed"],
  "properties": {
    "schema": {"const": "certified-candidate/v1"},
    "identity": {"type": "object"},
    "candidate": {"type": "object", "required": ["candidate_id", "candidate_hash", "certification_hash"]},
    "key_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "base_commit": {"type": "string", "minLength": 1},
    "source_snapshot_id": {"type": "string", "pattern": "^srcsnap_[0-9a-f]{24}$"},
    "source_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "baseline_fail_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "patch_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proposal_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approval_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "post_patch_test_result_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "jar_name": {"type": "string", "pattern": "^[^/\\\\]+\\.jar$"},
    "jar_size": {"type": "integer", "minimum": 1},
    "jar_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sbom_name": {"type": "string", "minLength": 1},
    "sbom_size": {"type": "integer", "minimum": 1},
    "sbom_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "certification_document_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "build_commands": {"type": "array", "items": {"type": "string"}},
    "control_allowed": {"const": false}
  }
}
