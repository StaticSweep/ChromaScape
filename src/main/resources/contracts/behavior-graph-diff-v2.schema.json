{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.leeuwbot.dev/sc728/behavior-graph-diff/v2",
  "title": "behavior-graph-diff/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "base_graph_id", "base_revision", "base_graph_hash", "reason", "operations"],
  "properties": {
    "schema": { "const": "behavior-graph-diff/v2" },
    "schema_version": { "const": "behavior-graph-diff/v2" },
    "base_graph_id": { "$ref": "#/$defs/identifier" },
    "base_revision": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "base_graph_hash": { "$ref": "#/$defs/hash" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "operations": { "type": "array", "maxItems": 768, "items": { "$ref": "#/$defs/operation" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "guard": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }, "parameters": { "type": "object" } }
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "label", "configuration"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["START", "STATE", "GATE", "SEMANTIC_ACTION", "WAIT", "ABSTAIN", "RECOVERY", "STOP", "SUCCESS", "FAILURE"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "semantic_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "reason_code": { "$ref": "#/$defs/reason_code" },
        "configuration": { "type": "object" },
        "timeout_ticks": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maximum_attempts": { "type": "integer", "minimum": 1, "maximum": 64 },
        "evidence_ids": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "priority", "source_order"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "from": { "$ref": "#/$defs/identifier" }, "to": { "$ref": "#/$defs/identifier" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 }, "source_order": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "guard": { "$ref": "#/$defs/guard" }, "reason_code": { "$ref": "#/$defs/reason_code" }
      }
    },
    "operation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["op", "node"], "properties": { "op": { "const": "add_node" }, "node": { "$ref": "#/$defs/node" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "node_id"], "properties": { "op": { "const": "remove_node" }, "node_id": { "$ref": "#/$defs/identifier" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "node"], "properties": { "op": { "const": "replace_node" }, "node": { "$ref": "#/$defs/node" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "edge"], "properties": { "op": { "const": "add_edge" }, "edge": { "$ref": "#/$defs/edge" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "edge_id"], "properties": { "op": { "const": "remove_edge" }, "edge_id": { "$ref": "#/$defs/identifier" } } }
      ]
    }
  }
}
