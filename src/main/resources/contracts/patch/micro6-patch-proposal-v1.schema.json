{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chromascape.local/contracts/patch/micro6-patch-proposal-v1.schema.json",
  "title": "Micro6 patch proposal canonical content",
  "type": "object",
  "required": [
    "schema", "incident_id", "iteration_id", "version", "source_snapshot_id",
    "source_manifest_hash", "repository_id", "base_commit", "base_tree", "base_build_id",
    "base_artifact_digest", "canonical_diff", "preimages", "citations",
    "validation_plan_hash", "generator_version", "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "micro6-patch-proposal/v1" },
    "incident_id": { "type": "string", "maxLength": 80 },
    "iteration_id": { "type": "string", "maxLength": 100 },
    "version": { "type": "integer", "minimum": 1 },
    "source_snapshot_id": { "type": "string", "pattern": "^srcsnap_[0-9a-f]{24}$" },
    "source_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "maxLength": 160 },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_build_id": { "type": "string", "maxLength": 160 },
    "base_artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canonical_diff": { "type": "string", "maxLength": 2000000 },
    "preimages": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "citations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["COMPILER_DIAGNOSTIC", "GRADLE_TASK", "RUN_EVIDENCE"] },
            "file": { "type": ["string", "null"] },
            "line": { "type": "integer" },
            "severity": { "type": ["string", "null"] },
            "message": { "type": ["string", "null"] }
          }
        }
      }
    },
    "validation_plan_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generator_version": { "type": "string", "maxLength": 60 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
