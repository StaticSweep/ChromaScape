{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromascape.dev/replay/scenario-manifest-v2.schema.json",
  "title": "Scenario Manifest v2",
  "description": "Immutable deterministic recording conversion contract for the xRSPS replay vertical slice.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "policyPointer": { "type": "string", "maxLength": 256, "pattern": "^(?:|/(?:[^~]|~[01])*)$" },
    "policyOperand": {
      "oneOf": [
        { "type": "object", "additionalProperties": false,
          "properties": { "kind": { "const": "literal" }, "value": { "oneOf": [
            { "type": "null" }, { "type": "boolean" },
            { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 },
            { "type": "string", "maxLength": 256 }
          ] } }, "required": ["kind", "value"] },
        { "type": "object", "additionalProperties": false,
          "properties": { "kind": { "const": "path" }, "pointer": { "$ref": "#/$defs/policyPointer" } },
          "required": ["kind", "pointer"] },
        { "type": "object", "additionalProperties": false,
          "properties": { "kind": { "const": "count" }, "pointer": { "$ref": "#/$defs/policyPointer" },
            "where": { "$ref": "#/$defs/policyPredicate" } }, "required": ["kind", "pointer"] },
        { "type": "object", "additionalProperties": false,
          "properties": { "kind": { "const": "sum" }, "pointer": { "$ref": "#/$defs/policyPointer" },
            "valuePointer": { "$ref": "#/$defs/policyPointer" }, "where": { "$ref": "#/$defs/policyPredicate" } },
          "required": ["kind", "pointer", "valuePointer"] }
      ]
    },
    "policyPredicate": {
      "oneOf": [
        { "type": "object", "additionalProperties": false,
          "properties": { "op": { "enum": ["all", "any"] },
            "predicates": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/policyPredicate" } } },
          "required": ["op", "predicates"] },
        { "type": "object", "additionalProperties": false,
          "properties": { "op": { "const": "not" }, "predicate": { "$ref": "#/$defs/policyPredicate" } },
          "required": ["op", "predicate"] },
        { "type": "object", "additionalProperties": false,
          "properties": { "op": { "const": "exists" }, "pointer": { "$ref": "#/$defs/policyPointer" } },
          "required": ["op", "pointer"] },
        { "type": "object", "additionalProperties": false,
          "properties": { "op": { "enum": ["some", "every"] }, "pointer": { "$ref": "#/$defs/policyPointer" },
            "predicate": { "$ref": "#/$defs/policyPredicate" } }, "required": ["op", "pointer", "predicate"] },
        { "type": "object", "additionalProperties": false,
          "properties": { "op": { "const": "compare" }, "comparison": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte"] },
            "left": { "$ref": "#/$defs/policyOperand" }, "right": { "$ref": "#/$defs/policyOperand" } },
          "required": ["op", "comparison", "left", "right"] }
      ]
    },
    "policyClauses": {
      "type": "array", "maxItems": 32,
      "items": { "type": "object", "additionalProperties": false,
        "properties": { "id": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
          "predicate": { "$ref": "#/$defs/policyPredicate" } }, "required": ["id", "predicate"] }
    },
    "terminationPolicy": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema": { "const": "xrsps-termination-policy/v1" },
        "success": { "$ref": "#/$defs/policyClauses" }, "failure": { "$ref": "#/$defs/policyClauses" },
        "stop": { "$ref": "#/$defs/policyClauses" } }, "required": ["schema", "success", "failure", "stop"]
    },
    "nativeBankSlot": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "slot": { "type": "integer", "minimum": 0, "maximum": 1409 },
        "itemId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "quantity": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "placeholder": { "type": "boolean" }, "filler": { "type": "boolean" },
        "tab": { "type": "integer", "minimum": 0, "maximum": 9 }
      },
      "required": ["slot", "itemId", "quantity", "placeholder", "filler", "tab"]
    },
    "nativeBank": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "capacity": { "type": "integer", "minimum": 1, "maximum": 1410 },
        "slots": { "type": "array", "maxItems": 1410, "items": { "$ref": "#/$defs/nativeBankSlot" } },
        "withdrawNotes": { "type": "boolean" }, "insertMode": { "type": "boolean" },
        "placeholderMode": { "type": "boolean" },
        "quantityMode": { "type": "integer", "minimum": 0, "maximum": 5 },
        "customQuantity": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "currentTab": { "type": "integer", "minimum": 0, "maximum": 9 },
        "tabDisplayMode": { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "required": ["capacity", "slots", "withdrawNotes", "insertMode", "placeholderMode",
        "quantityMode", "customQuantity", "currentTab", "tabDisplayMode"]
    },
    "nativeFishingWorld": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "xrsps-native-fishing-world/v1" },
        "catalogChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "spawnIndices": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 99999 } }
      },
      "required": ["schema", "catalogChecksum", "spawnIndices"]
    },
    "nativeNpcBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionIndex": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "tick": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "sourceStableId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "spawnIndex": { "type": "integer", "minimum": 0, "maximum": 99999 },
        "npcTypeId": { "type": "integer", "minimum": 1, "maximum": 65534 },
        "position": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "x": { "type": "integer", "minimum": 0, "maximum": 16383 },
            "y": { "type": "integer", "minimum": 0, "maximum": 16383 },
            "plane": { "type": "integer", "minimum": 0, "maximum": 3 }
          },
          "required": ["x", "y", "plane"]
        },
        "sourceSnapshotRef": { "type": "string", "pattern": "^snapshot:sha256:[0-9a-f]{64}$" }
      },
      "required": ["actionIndex", "tick", "sequence", "sourceStableId", "spawnIndex", "npcTypeId", "position", "sourceSnapshotRef"]
    },
    "nativeNpcBindings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": { "const": "xrsps-native-npc-bindings/v1" },
        "catalogChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bindings": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/nativeNpcBinding" } }
      },
      "required": ["schema", "catalogChecksum", "bindings"]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "plane": { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "required": ["x", "y", "plane"]
    },
    "slot": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "slot": { "type": "integer", "minimum": 0 },
        "itemId": { "type": "integer", "minimum": 0 },
        "quantity": { "type": "integer", "minimum": 0 }
      },
      "required": ["slot", "itemId"]
    },
    "semanticAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
          "WAIT_UNTIL_TICK", "INTERACT_NPC", "INTERACT_OBJECT", "WALK_TO",
            "INTERACT_GROUND_ITEM", "INTERACT_INVENTORY_ITEM", "INTERACT_WIDGET",
            "SELECT_DIALOGUE_OPTION", "CAST_SPELL", "EQUIP_ITEM",
            "INVENTORY_ACTION", "USE_ITEM_ON_NPC"
          ]
        },
        "mappingVersion": { "enum": ["1.0.0", "1.1.0"] },
        "tick": { "type": "integer", "minimum": 0 },
        "targetStableId": { "type": "string", "minLength": 1 },
        "option": { "type": "string" },
        "destination": { "$ref": "#/$defs/position" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 27 },
        "itemId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sourceSlot": { "type": "integer", "minimum": 0, "maximum": 27 },
        "sourceItemId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sourceItem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slot": { "type": "integer", "minimum": 0, "maximum": 27 },
            "itemId": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          },
          "required": ["slot", "itemId"]
        },
        "productId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 28 },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "quantity" },
                "value": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
              },
              "required": ["kind", "value"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "exchange-offer" },
                "side": { "enum": ["buy", "sell"] },
                "itemId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
                "quantity": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
                "price": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
              },
              "required": ["kind", "side", "itemId", "quantity", "price"]
            }
          ]
        },
        "optionIndex": { "type": "integer", "minimum": 0, "maximum": 255 },
        "spellId": { "type": "integer", "minimum": 1 },
        "widgetId": { "type": "integer", "minimum": 0 },
        "widgetIndex": { "type": "integer", "minimum": -1, "maximum": 65535 },
        "equipmentSlot": { "type": "integer", "minimum": 0, "maximum": 13 },
        "sourceActionTick": { "type": "integer", "minimum": 0 },
        "sourceActionSequence": { "type": "integer", "minimum": 0 },
        "provenance": { "type": "string" },
        "provenanceReason": { "type": "string" },
        "sourceEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logId": { "type": "integer", "minimum": 0 },
            "snapshotId": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "required": ["type"],
      "dependentRequired": {
        "sourceSlot": ["sourceItemId"], "sourceItemId": ["sourceSlot"],
        "productId": ["quantity"], "quantity": ["productId"]
      },
      "allOf": [
        {
          "if": { "required": ["sourceItem"] },
          "then": { "properties": { "type": { "const": "INTERACT_OBJECT" } } }
        },
        {
          "if": { "anyOf": [{ "required": ["sourceSlot"] }, { "required": ["sourceItemId"] }] },
          "then": { "properties": { "type": { "const": "INTERACT_INVENTORY_ITEM" } } }
        },
        {
          "if": { "anyOf": [{ "required": ["productId"] }, { "required": ["quantity"] }, { "required": ["input"] }] },
          "then": {
            "properties": { "type": { "const": "INTERACT_WIDGET" } },
            "not": { "required": ["input", "productId"] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "WAIT_UNTIL_TICK" } } },
          "then": { "required": ["tick"] }
        },
        {
          "if": { "properties": { "type": { "const": "INTERACT_NPC" } } },
          "then": { "required": ["targetStableId", "option"] }
        },
        {
          "if": { "properties": { "type": { "const": "INTERACT_OBJECT" } } },
          "then": { "required": ["targetStableId", "option"] }
        },
        {
          "if": { "properties": { "type": { "const": "INTERACT_GROUND_ITEM" } } },
          "then": { "required": ["targetStableId", "option"] }
        },
        {
          "if": { "properties": { "type": { "const": "INTERACT_INVENTORY_ITEM" } } },
          "then": { "required": ["targetStableId", "slot", "itemId", "option"] }
        },
        {
          "if": { "properties": { "type": { "const": "INTERACT_WIDGET" } } },
          "then": { "required": ["targetStableId", "option"] }
        },
        {
          "if": { "properties": { "type": { "const": "SELECT_DIALOGUE_OPTION" } } },
          "then": { "required": ["targetStableId"] }
        },
        {
          "if": { "properties": { "type": { "const": "CAST_SPELL" } } },
          "then": {
            "required": ["targetStableId"],
            "anyOf": [{ "required": ["spellId"] }, { "required": ["option"] }],
            "dependentRequired": { "slot": ["itemId"], "itemId": ["slot"] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "EQUIP_ITEM" } } },
          "then": { "required": ["targetStableId", "slot", "itemId"] }
        },
        {
          "if": { "properties": { "type": { "const": "WALK_TO" } } },
          "then": { "required": ["destination"] }
        },
        {
          "if": { "properties": { "type": { "const": "INVENTORY_ACTION" } } },
          "then": { "required": ["slot", "itemId", "option"] }
        },
        {
          "if": { "properties": { "type": { "const": "USE_ITEM_ON_NPC" } } },
          "then": { "required": ["slot", "itemId", "targetStableId"] }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "provenance": { "type": "string" },
        "sourceLogId": { "type": "integer", "minimum": 0 },
        "sourceRef": { "type": "string", "minLength": 1 }
      },
      "required": ["tick", "code", "message", "provenance"]
    },
    "approximation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "provenance": { "type": "string" },
        "sourceSnapshotId": { "type": "integer", "minimum": 0 }
      },
      "required": ["tick", "code", "message", "provenance"]
    }
  },
  "properties": {
    "manifestVersion": { "type": "integer", "const": 2 },
    "compilationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "behaviorRunContext": { "type": "object" },
        "world": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initialSnapshotRef": { "type": "string", "minLength": 1 },
            "staticContent": { "type": "object" },
            "actionTargets": { "type": "array", "maxItems": 10000, "items": { "type": "object" } },
            "requiredNativeBindings": { "type": "array", "items": { "type": "object" } }
          },
          "required": ["initialSnapshotRef", "staticContent", "actionTargets", "requiredNativeBindings"]
        },
        "fieldProvenance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provenance": { "enum": ["OBSERVED", "DERIVED", "OPERATOR_SUPPLIED", "DEFAULTED"] },
              "sourceRef": { "type": "string", "minLength": 1 },
              "outputPointer": { "type": "string" }
            },
            "required": ["provenance", "sourceRef", "outputPointer"]
          }
        }
      },
      "required": ["world", "fieldProvenance"]
    },
    "manifestId": { "type": "string", "minLength": 1 },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordingId": { "type": "string", "minLength": 1 },
        "recordingChecksum": { "type": "string", "minLength": 1 },
        "debugSessionId": { "type": "string", "minLength": 1 },
        "debugSessionChecksum": { "type": "string", "minLength": 1 },
        "startTick": { "type": "integer", "minimum": 0 },
        "endTick": { "type": "integer", "minimum": 0 }
      },
      "required": ["recordingId", "recordingChecksum", "debugSessionId", "debugSessionChecksum", "startTick", "endTick"]
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curationId": { "type": "string", "minLength": 1 },
        "datasetRole": { "enum": ["TRAIN", "VALIDATION", "HELD_OUT"] },
        "sourceCuration": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 },
            "checksum": { "type": "string", "minLength": 1 },
            "role": { "enum": ["TRAIN", "VALIDATION", "HELD_OUT"] },
            "canonicalContentChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "contentSnapshot": { "type": "object" }
          },
          "required": ["id", "version", "checksum", "role", "canonicalContentChecksum", "contentSnapshot"]
        },
        "version": { "type": "integer", "minimum": 1 },
        "checksum": { "type": "string", "minLength": 1 }
      },
      "required": ["curationId", "version", "checksum"]
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "const": 2 }
      },
      "required": ["version", "schemaVersion"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xrspsAdapterVersion": { "type": "string", "minLength": 1 },
        "xrspsBuildCommit": { "type": "string", "minLength": 1 },
        "cacheRevision": { "type": "string", "minLength": 1 },
        "contentRevision": { "type": "string", "minLength": 1 }
      },
      "required": ["xrspsAdapterVersion", "xrspsBuildCommit", "cacheRevision", "contentRevision"]
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "string", "minLength": 1 },
        "clockOrigin": { "type": "string", "format": "date-time" },
        "tickDurationMs": { "type": "integer", "const": 600 },
        "idNamespace": { "type": "string", "minLength": 1 }
      },
      "required": ["seed", "clockOrigin", "tickDurationMs", "idNamespace"]
    },
    "initialState": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "worldId": { "type": "integer" },
        "collisionRevision": { "type": "string" },
        "nativeFishingWorld": { "$ref": "#/$defs/nativeFishingWorld" },
        "bank": { "$ref": "#/$defs/nativeBank" },
        "bankOpen": { "type": "boolean" },
        "travelProfile": { "const": "jewelry-v1" },
        "nativeNpcBindings": { "$ref": "#/$defs/nativeNpcBindings" },
        "player": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "position": { "$ref": "#/$defs/position" },
            "skills": { "type": "object" },
            "inventory": { "type": "array", "items": { "$ref": "#/$defs/slot" } },
            "equipment": { "type": "array", "items": { "$ref": "#/$defs/slot" } }
          },
          "required": ["position", "inventory", "equipment"]
        },
        "npcs": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "objects": { "type": "array" },
        "groundItems": { "type": "array" }
      },
      "required": ["worldId", "player", "npcs", "objects", "groundItems"]
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/semanticAction" },
      "maxItems": 10000,
      "minItems": 1
    },
    "expectations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected": {},
          "level": { "type": "string", "enum": ["HARD", "SOFT", "INFO"] },
          "tolerance": {}
        },
        "required": ["expected", "level"]
      }
    },
    "tolerances": { "type": "object" },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["AUTO", "CAPTURED_ONLY", "LEGACY_BEST_EFFORT"] },
        "quality": { "type": "string", "enum": ["CERTIFIED", "BEST_EFFORT", "UNSUPPORTED"] },
        "conversionChecksum": { "type": "string", "minLength": 1 },
        "typedActionCount": { "type": "integer", "minimum": 0 },
        "legacyLogCount": { "type": "integer", "minimum": 0 },
        "actionCoveragePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
        "approximations": { "type": "array", "items": { "$ref": "#/$defs/approximation" } }
      },
      "required": ["mode", "quality", "conversionChecksum", "typedActionCount", "legacyLogCount", "actionCoveragePct", "gaps", "approximations"]
    },
    "fidelity": { "type": "string", "enum": ["SYNTHETIC_CONTRACT", "XRSPS_AUTHORITATIVE"] },
    "fidelityRequirement": { "type": "string", "enum": ["CERTIFIED", "BEST_EFFORT", "UNSUPPORTED"] },
    "controlAllowed": { "type": "boolean", "const": false },
    "termination": { "$ref": "#/$defs/terminationPolicy" },
    "execution": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": { "const": "xrsps-execution-limits/v1" },
        "maximumTicks": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "maximumActions": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maximumSteps": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "required": ["schema", "maximumTicks", "maximumActions", "maximumSteps"]
    },
    "manifestChecksum": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "compiler": { "properties": { "version": { "const": "2.1.0" } } } } },
      "then": { "required": ["compilationEvidence"] }
    },
    {
      "if": { "properties": { "compiler": { "properties": { "version": { "const": "2.3.0" } } } } },
      "then": { "required": ["compilationEvidence", "execution"] }
    },
    {
      "if": { "properties": { "compiler": { "properties": { "version": { "const": "2.4.0" } } } } },
      "then": { "required": ["compilationEvidence", "execution", "termination"] }
    }
  ],
  "required": [
    "manifestVersion", "manifestId", "recording", "curation", "compiler", "runtime",
    "determinism", "initialState", "actions", "expectations", "tolerances", "conversion",
    "fidelity", "fidelityRequirement", "controlAllowed", "manifestChecksum"
  ]
}
