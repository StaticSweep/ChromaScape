  "$defs": {
    "captureQuality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "capture-quality/v1"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 100
        },
        "producerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,64}$"
        },
        "epochTick": {
          "type": "integer",
          "minimum": 0
        },
        "epochCapturedAtEpochMillis": {
          "type": "integer"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "tickCapturedAtEpochMillis": {
          "type": "integer"
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "MEASURED",
                "UNAVAILABLE"
              ]
            },
            "qualityCode": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "measuredAtEpochMillis": {
              "type": [
                "integer",
                "null"
              ]
            },
            "serverOffsetMillis": {
              "type": [
                "number",
                "null"
              ]
            },
            "uncertaintyMillis": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "status"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "MEASURED"
                  }
                }
              },
              "then": {
                "required": [
                  "measuredAtEpochMillis",
                  "serverOffsetMillis",
                  "uncertaintyMillis"
                ],
                "properties": {
                  "measuredAtEpochMillis": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "serverOffsetMillis": {
                    "type": "number"
                  },
                  "uncertaintyMillis": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 50
                  }
                }
              }
            }
          ]
        },
        "rawEvents": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9-]{1,64}$"
              },
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "sessionId": {
                "type": "string",
                "maxLength": 100
              },
              "producerId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9-]{1,64}$"
              },
              "source": {
                "type": "string",
                "const": "CLIENT_EVENT"
              },
              "sourceTick": {
                "type": "integer",
                "minimum": 0
              },
              "producer": {
                "type": "string",
                "const": "micro6-combat-menu/v1"
              },
              "capturedAtEpochMillis": {
                "type": "integer"
              },
              "family": {
                "const": "MENU_CALLBACK"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "opcode": {
                    "type": "integer"
                  },
                  "identifier": {
                    "type": "integer"
                  },
                  "param0": {
                    "type": "integer"
                  },
                  "param1": {
                    "type": "integer"
                  }
                },
                "required": [
                  "opcode",
                  "identifier",
                  "param0",
                  "param1"
                ]
              },
              "payloadHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "eventId",
              "sequence",
              "sessionId",
              "producerId",
              "source",
              "sourceTick",
              "producer",
              "capturedAtEpochMillis",
              "family",
              "payload",
              "payloadHash"
            ]
          }
        },
        "settlements": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9-]{1,64}$"
              },
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "sessionId": {
                "type": "string",
                "maxLength": 100
              },
              "producerId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9-]{1,64}$"
              },
