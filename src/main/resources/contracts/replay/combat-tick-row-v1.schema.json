      "description": "Optional capture-quality/v1 immutable CLIENT_EVENT evidence, bounded by ingestion. Confirmed lineage and measured quality are required for CLIENT_EVENT_SETTLED labels.",
      "x-provenance": "captured",
      "x-producer": "Micro6 CombatSemanticCapture",
      "x-labelRole": "diagnostic",
      "$ref": "#/$defs/captureQuality"
