                    "additionalProperties": false,
                    "properties": {
                      "npcId": {
                        "type": "integer"
                      },
                      "clientIndex": {
                        "type": "integer"
                      },
                      "x": {
                        "type": "integer"
                      },
                      "y": {
                        "type": "integer"
                      },
                      "plane": {
                        "type": "integer"
                      },
                      "quantity": {
                        "type": "integer"
                      },
                      "active": {
                        "type": "boolean"
                      }
                    },
                    "required": []
                  },
                  "after": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "npcId": {
                        "type": "integer"
                      },
                      "clientIndex": {
                        "type": "integer"
                      },
                      "x": {
                        "type": "integer"
                      },
                      "y": {
                        "type": "integer"
                      },
                      "plane": {
                        "type": "integer"
                      },
                      "quantity": {
                        "type": "integer"
                      },
                      "active": {
                        "type": "boolean"
                      }
                    },
                    "required": []
                  },
                  "movementIntent": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "source": {
                        "const": "SELECTED_SCENE_TILE_AND_CHANGED_LOCAL_DESTINATION"
