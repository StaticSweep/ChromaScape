                  "clientIndex": {
                    "type": "integer"
                  },
                  "itemId": {
                    "type": "integer"
                  },
                  "slot": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 27
                  },
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  },
                  "plane": {
                    "type": "integer"
                  },
                  "widgetId": {
                    "type": "integer"
                  },
                  "stableId": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "prayer": {
                    "type": "string",
                    "maxLength": 64
                  }
