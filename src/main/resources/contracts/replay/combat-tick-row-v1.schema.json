{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromascape.dev/replay/combat-tick-row-v1.schema.json",
  "title": "Combat Tick Row v1",
  "description": "SC-1976: combat-oriented per-tick training row. Every field carries provenance (captured = produced by micro6 schema-4 collectors and stored by ChromaScape, derived = computed from stored data, deferred = producer absent on this payload) and labelRole (label = permitted training target, diagnostic = evidence only per SC-718/SC-751, context = model input features). Raw mouse/menu inputs are diagnostic-only and must never become training labels.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "combat-tick-row/v1" },
    "tick_id": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string" },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hp": { "type": ["integer", "null"] },
        "maxHp": { "type": ["integer", "null"] },
        "prayer": { "type": ["integer", "null"] },
        "maxPrayer": { "type": ["integer", "null"] },
        "runEnergy": { "type": ["integer", "null"] },
        "specialAttack": { "type": ["integer", "null"], "description": "Captured by micro6 schema-4 collectors (special-attack varp, percent 0-100); null on older payloads." },
        "animationId": { "type": ["integer", "null"] },
        "x": { "type": ["integer", "null"] },
        "y": { "type": ["integer", "null"] },
        "plane": { "type": ["integer", "null"] }
      },
      "required": ["hp", "prayer", "runEnergy", "animationId", "x", "y", "plane"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "description": "DERIVED: resolved by joining playerState.interacting.index to npcs[].index. Nulls with resolved=false when nothing is targeted.",
      "properties": {
        "resolved": { "type": "boolean" },
        "targetId": { "type": ["integer", "null"] },
        "targetHp": { "type": ["integer", "null"] },
        "targetMaxHp": { "type": ["integer", "null"] },
        "targetHealthRatio": { "type": ["integer", "null"], "description": "Captured NPC health-bar ratio; not absolute hitpoints." },
        "targetHealthScale": { "type": ["integer", "null"], "description": "Captured NPC health-bar scale; not maximum hitpoints." },
        "targetAnimation": { "type": ["integer", "null"] },
        "x": { "type": ["integer", "null"] },
        "y": { "type": ["integer", "null"] }
      },
      "required": ["resolved"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nearbyNpcs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": { "type": "integer" },
              "id": { "type": ["integer", "null"] },
              "name": { "type": ["string", "null"] },
              "hp": { "type": ["integer", "null"] },
              "healthRatio": { "type": ["integer", "null"] },
              "healthScale": { "type": ["integer", "null"] },
              "animation": { "type": ["integer", "null"] },
              "x": { "type": ["integer", "null"] },
              "y": { "type": ["integer", "null"] },
              "distance": { "type": ["integer", "null"] }
            }
          }
        },
        "projectiles": { "type": "array", "items": { "type": "object" } },
        "groundObjects": { "type": "array", "items": { "type": "object" } },
        "tiles": {
          "type": ["array", "null"],
          "description": "Captured by micro6 schema-4 collectors (bounded collision-flag grid); null when the grid never arrived.",
          "items": {
            "type": "object",
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "plane": { "type": "integer" },
              "flags": { "type": "integer" },
              "blocked": { "type": "boolean" }
            }
          }
        },
        "hazards": {
          "type": "array",
          "description": "Captured by micro6 schema-4 collectors (NPC attackers + incoming projectiles); empty means none active.",
          "items": { "type": "object" }
        },
        "phase": { "type": ["object", "null"], "description": "Captured encounter envelope (identity + HP signal); phaseIndex stays null until per-boss varbit content lands." },
        "prayersActive": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Captured by micro6 schema-4 collectors (toggled prayer names); empty means none on, null on older payloads." }
      },
      "required": ["nearbyNpcs", "projectiles", "groundObjects", "hazards"]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ids": { "type": "array", "items": { "type": "integer" } },
        "amounts": { "type": "array", "items": { "type": "integer" } },
        "slots": { "type": "array", "items": { "type": "integer" } }
      },
      "required": ["ids", "amounts", "slots"]
    },
    "equipment": { "type": "array", "items": { "type": "object" } },
    "diagnosticInputs": {
      "type": "object",
      "additionalProperties": false,
      "description": "DIAGNOSTIC-ONLY per SC-718/SC-751. Raw inputs are evidence, never training labels. Captured by micro6 schema-4 collectors (manual-input snapshot + typed-action join); null when unobserved.",
      "properties": {
        "mouseX": { "type": ["integer", "null"] },
        "mouseY": { "type": ["integer", "null"] },
        "mouseButton": { "type": ["integer", "null"] },
        "menuOption": { "type": ["string", "null"] },
        "clickedEntity": { "type": ["string", "null"] },
        "clickedTile": {
          "type": ["object", "null"],
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "plane": { "type": "integer" }
          }
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "description": "The sole permitted training target: one semantic action. Combat vocabulary maps to semantic-action-v1 canonical types; PRAYER_MAGIC is ambiguous (prayer toggle vs combat spell) and stays unmapped until micro6 disambiguates it.",
      "properties": {
        "vocab": { "type": ["string", "null"], "enum": ["ATTACK", "EAT", "PRAYER_MAGIC", "MOVE_TILE", "CAST_SPELL", "WAIT", null] },
        "canonicalType": { "type": ["string", "null"] },
        "provenance": { "type": ["string", "null"] },
        "sourceTick": { "type": ["integer", "null"] },
        "sequence": { "type": ["integer", "null"] },
        "unmapped": { "type": "boolean" }
      },
      "required": ["unmapped"]
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "description": "DERIVED via TickVideoSyncService formula frame=(tick-startTick)*fps*0.6; frameEnd is frame(tick+1)-1. Nulls with hasVideo=false when the session has no recording.",
      "properties": {
        "hasVideo": { "type": "boolean" },
        "fps": { "type": ["integer", "null"] },
        "frameStart": { "type": ["integer", "null"] },
        "frameEnd": { "type": ["integer", "null"] }
      },
      "required": ["hasVideo"]
    },
    "deferred": {
      "type": "array",
      "description": "Proposed fields whose producer was absent on this payload (pre-schema-4 client, disabled stream, or no video). Empty means every producer ran: the row is coverage-ready for SC-752.",
      "items": { "type": "string" }
    }
  },
  "required": ["schema", "tick_id", "player", "target", "environment", "inventory", "equipment", "label", "video", "deferred"]
}
