                      "baseX": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "baseY": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "plane": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "selectedSceneX": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 103
                      },
                      "selectedSceneY": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 103
                      },
                      "destinationSceneX": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 103
                      },
                      "destinationSceneY": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 103
                      },
                      "previousDestinationSceneX": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 103
                      },
                      "previousDestinationSceneY": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 103
                      },
                      "sourceTick": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "observedTick": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "previousDestinationPresent": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "source",
                      "coordinateSpace",
                      "baseX",
                      "baseY",
                      "plane",
                      "selectedSceneX",
                      "selectedSceneY",
                      "destinationSceneX",
                      "destinationSceneY",
                      "sourceTick",
                      "observedTick",
                      "previousDestinationPresent"
                    ]
                  }
                },
                "required": [
                  "beforeTick",
                  "afterTick",
                  "before",
                  "after"
                ]
              }
            },
            "required": [
              "eventId",
              "sequence",
              "sessionId",
              "producerId",
              "source",
              "sourceTick",
              "target",
              "settlementTick",
              "outcomeHorizonTick",
              "status",
              "reason",
              "confidence",
              "rawEventIds",
              "derivation",
              "observationTick"
            ]
          }
        },
        "pendingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "qualityCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_]{1,64}$"
          }
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "sessionId",
        "producerId",
        "epochTick",
        "epochCapturedAtEpochMillis",
        "tick",
        "tickCapturedAtEpochMillis",
        "clock",
        "rawEvents",
        "settlements",
        "pendingCount",
        "qualityCodes",
        "terminal"
      ],
      "description": "Additive checksum-covered immutable CLIENT_EVENT raw-source and mutation-backed settlement evidence. Ingestion additionally verifies exact session/tick binding, sorted numeric payload hash, lineage/horizon and actual captured mutation. 256KiB section bound. Constructed fixtures do not certify real combat acceptance."
