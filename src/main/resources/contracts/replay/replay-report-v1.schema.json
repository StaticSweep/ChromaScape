{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromascape.dev/replay/replay-report-v1.schema.json",
  "title": "Replay Report",
  "description": "Immutable final report for a replay run.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reportVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string" },
    "attemptId": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": ["OBSERVED_PLAYBACK", "POLICY_REPLAY", "CAUSAL_SIMULATION"]
    },
    "manifestChecksum": { "type": "string" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "fidelity": {
      "type": "string",
      "enum": ["SYNTHETIC_CONTRACT", "XRSPS_AUTHORITATIVE"]
    },
    "conversionQuality": {
      "type": "string",
      "enum": ["CERTIFIED", "BEST_EFFORT", "UNSUPPORTED"]
    },
    "actionCoveragePct": { "type": "number", "minimum": 0, "maximum": 100 },
    "gapCount": { "type": "integer", "minimum": 0 },
    "approximationCount": { "type": "integer", "minimum": 0 },
    "viewerTraceChecksum": { "type": "string" },
    "viewerTraceFrameCount": { "type": "integer", "minimum": 0 },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xrspsAdapterVersion": { "type": "string" },
        "xrspsBuildCommit": { "type": "string" },
        "cacheRevision": { "type": "string" },
        "contentRevision": { "type": "string" }
      },
      "required": ["xrspsAdapterVersion", "xrspsBuildCommit", "cacheRevision", "contentRevision"]
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "terminalAt": { "type": "string", "format": "date-time" },
    "outcome": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "CANCELLED", "TIMED_OUT", "INFRASTRUCTURE_FAILURE"]
    },
    "executedActionCount": { "type": "integer", "minimum": 0 },
    "checkpointCount": { "type": "integer", "minimum": 0 },
    "firstHardMismatch": { "$ref": "replay-mismatch-v1.schema.json" },
    "mismatchTotals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hard": { "type": "integer", "minimum": 0 },
        "soft": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      },
      "required": ["hard", "soft", "info"]
    },
    "mismatchHardCount": { "type": "integer", "minimum": 0 },
    "mismatchSoftCount": { "type": "integer", "minimum": 0 },
    "mismatchInfoCount": { "type": "integer", "minimum": 0 },
    "finalStateHash": { "type": "string" },
    "finalChainHash": { "type": "string" },
    "artifactRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "terminalReason": { "type": "string" },
    "controlAllowed": { "type": "boolean", "const": false },
    "reportChecksum": { "type": "string" }
  },
  "required": [
    "reportVersion",
    "runId",
    "attemptId",
    "mode",
    "manifestChecksum",
    "runtimeIdentity",
    "outcome",
    "executedActionCount",
    "mismatchTotals",
    "controlAllowed",
    "reportChecksum"
  ]
}
