{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromascape.dev/replay/replay-mismatch-v1.schema.json",
  "title": "Replay Mismatch",
  "description": "A single mismatch between recorded and simulated state.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mismatchVersion": { "type": "integer", "const": 1 },
    "level": {
      "type": "string",
      "enum": ["HARD", "SOFT", "INFO"]
    },
    "ruleId": { "type": "string" },
    "firstTick": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "domain": { "type": "string" },
    "jsonPointer": { "type": "string" },
    "expected": {},
    "actual": {},
    "relatedActionOrdinal": { "type": "integer", "minimum": 0 },
    "checkpointId": { "type": "string" },
    "causalParentId": { "type": "string" },
    "cascadeCount": { "type": "integer", "minimum": 0 }
  },
  "required": ["mismatchVersion", "level", "ruleId", "firstTick", "sequence", "domain"]
}