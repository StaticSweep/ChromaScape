/gradlew text eol=lf
# JSON contracts and golden fixtures are hashed and compared byte-for-byte. Keep their checkout
# representation stable on every host, including Windows machines with core.autocrlf enabled.
*.json text eol=lf
src/test/resources/micro6-fixtures/* text eol=lf
/src/test/resources/tick-batch-*.json text eol=lf
/src/test/resources/recording-action-checksum-vectors.json text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.jar binary
docs/MCP_QUICK_START.md text eol=lf
src/main/resources/templates/debugger.html text eol=lf
# Quest contract mirrors are compared byte-for-byte across repositories and resource trees;
# force LF so a Windows checkout cannot materialize them differently from the committed blobs.
src/main/resources/contracts/quest/*.json text eol=lf
src/test/resources/contracts/quest/*.json text eol=lf
src/main/resources/contracts/source/task-source-manifest-v1.schema.json text eol=lf
src/test/resources/task-source-canonical-json-v1-vectors.json text eol=lf
src/main/resources/contracts/gameplay/sc-1429-gameplay-contract-v1.schema.json text eol=lf
src/main/resources/contracts/gameplay/sc-1429-golden-fixtures-v1.json text eol=lf
src/main/resources/contracts/gameplay/sc-1429-gameplay-contract-v2.schema.json text eol=lf
src/main/resources/contracts/gameplay/sc-1429-golden-fixtures-v2.json text eol=lf
