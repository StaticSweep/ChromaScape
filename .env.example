# Copy this file to .env.local and adjust for the current Windows machine.
BUILDER_GOAL_MICRO6_PROJECT_DIR=C:\Dev\IdeaProjects\micro6
BUILDER_GOAL_LAUNCHER_LOCAL_MACHINE_UUID=
BUILDER_GOAL_MICRO6_VALIDATION_TIMEOUT_MS=300000

# Optional Fedora Builder Goal agent. UUID + endpoint are pinned, never supplied by the UI.
# Use the same random token (at least 32 characters) in Fedora MICRO6_AGENT_TOKEN.
# Source: SC-1661 adapted from 97284f1 "Add remote Fedora Builder Goal launcher routing".
BUILDER_GOAL_REMOTE_MACHINE_UUID=
BUILDER_GOAL_REMOTE_ENDPOINT=http://192.168.1.21:8101
BUILDER_GOAL_REMOTE_EXECUTOR_URL=http://192.168.1.21:8098
BUILDER_GOAL_REMOTE_TOKEN=
BUILDER_GOAL_REMOTE_TIMEOUT_SECONDS=1800

# SC-1498 one-use gameplay bootstrap. Keep disabled until the exact human-approved run.
# Use different random values for the operator key and authority secret; both need 32+ characters.
GAMEPLAY_BOOTSTRAP_OPERATOR_ENABLED=false
GAMEPLAY_BOOTSTRAP_OPERATOR_KEY=
GAMEPLAY_BOOTSTRAP_AUTHORITY_HMAC_SECRET=
GAMEPLAY_BOOTSTRAP_MICRO6_URL=http://127.0.0.1:8098
GAMEPLAY_BOOTSTRAP_EVIDENCE_ROOT=.chromascape/bootstrap-recordings

# SC-1430 decide-only provider runtime. Keep disabled until operator authentication,
# provider credentials, golden smoke tests and downstream shadow validation have passed.
GAMEPLAY_PROVIDER_RUNTIME_ENABLED=false
GAMEPLAY_PROVIDER_RUNTIME_OPERATOR_KEY=
GAMEPLAY_PROVIDER_CLAUDE_COMMAND=claude
GAMEPLAY_PROVIDER_CODEX_COMMAND=codex
GAMEPLAY_PROVIDER_RUNTIME_WORK_ROOT=.chromascape/provider-runtime-work
GAMEPLAY_PROVIDER_TRANSCRIPT_ROOT=.chromascape/provider-transcripts
GAMEPLAY_PROVIDER_PROCESS_START_TIMEOUT_MS=5000
GAMEPLAY_PROVIDER_FIRST_EVENT_TIMEOUT_MS=30000
GAMEPLAY_PROVIDER_TOOL_RESPONSE_TIMEOUT_MS=5000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SC-1431 AccountBuilder orchestration. Keep both flags false until SC-1429, SC-573, SC-666 and
# SC-1449 conformance are complete. The operator key must contain 32+ random characters if enabled.
GAMEPLAY_ACCOUNTBUILDER_ORCHESTRATION_ENABLED=false
GAMEPLAY_ACCOUNTBUILDER_LIVE_DELIVERY_ENABLED=false
GAMEPLAY_ACCOUNTBUILDER_ORCHESTRATION_OPERATOR_KEY=

# AI-player fishing prototype (replay-only; leave control disabled)
FEATURES_AI_PLAYER_ENABLED=false
FEATURES_AI_PLAYER_SHADOW=false
FEATURES_AI_PLAYER_CONTROL=false
AI_PLAYER_DATASET_DIR=.chromascape/datasets

# Recording startup readiness window (optional overrides; defaults work without local config)
RECORDING_INITIAL_FRAME_TIMEOUT_MS=15000
RECORDING_INITIAL_FRAME_RETRY_INTERVAL_MS=250

# SC-967 certified-candidate workflow (candidate builds must stay DISABLED until all are set)
# Operator authentication for /api/v1/ai-routine/patches/**
AI_ROUTINE_OPERATOR_TOKEN=
AI_ROUTINE_OPERATOR_ID=operator

# Capture transport authentication
AI_ROUTINE_CAPTURE_TOKEN=

# Candidate registry + signing (external Go registry)
LEEUWBOT_CANDIDATE_REGISTRY_URL=http://127.0.0.1:8081
STATIC_API_TOKEN=
CANDIDATE_SIGNING_PRIVATE_KEY_PATH=
CANDIDATE_SIGNING_PUBLIC_KEY_PATH=
CANDIDATE_SIGNING_KEY_ID=

# Durable candidate staging root and exact release JAR name (required for builds)
SC967_CANDIDATE_STAGING_ROOT=C:\Dev\IdeaProjects\ChromaScape\output\candidate-staging
MICRO6_EXPECTED_ARTIFACT_NAME=microbot-1.0.0.jar
# Offline Gradle cache copied into the worker's temporary GRADLE_USER_HOME
SC967_GRADLE_USER_HOME=C:\Dev\IdeaProjects\micro6\.gradle-cache
# Gate: set to true only after the operator token/ID, signing key, staging root and JAR name are configured
SC967_CANDIDATE_BUILDS_ENABLED=false

# SC-810 authoritative source provenance. All values required by the source trust boundary must be
# configured with deployment-specific values; blank values intentionally fail startup validation.
CHROMASCAPE_SOURCE_PUBLIC_KEY_BASE64=
CHROMASCAPE_SOURCE_PUBLIC_KEY_ID=
CHROMASCAPE_SOURCE_ENVIRONMENT=
CHROMASCAPE_SOURCE_METADATA_TOKEN=
CHROMASCAPE_SOURCE_CONTENT_TOKEN=
CHROMASCAPE_SOURCE_ACTOR_ID=debugger

# Micro6 producer source API transport. ChromaScape sends this bearer credential and the explicit
# environment/actor/purpose/correlation headers on every authoritative read.
MICRO6_SOURCE_TRANSPORT_BASE_URL=
MICRO6_SOURCE_TRANSPORT_AUTH_TOKEN=
MICRO6_SOURCE_TRANSPORT_ACTOR=chromascape-web

# SC-1173 Builder Goal compile recovery. The master mutations flag gates every POST and cancel.
# Validation also requires the master and isolated-validation flags. Rerun additionally requires
# master, validation, candidate-rerun, and verified exact-digest Micro6 activation support.
# Recovery mutations reuse the AI routine operator token/ID for constant-time operator auth.
BUILDER_GOAL_RECOVERY_MUTATIONS_ENABLED=false
BUILDER_GOAL_RECOVERY_ISOLATED_VALIDATION_ENABLED=false
BUILDER_GOAL_RECOVERY_CANDIDATE_RERUN_ENABLED=false
# Production authority requires a signed Micro6 source manifest; set false only for offline
# development with an explicitly clean pinned checkout.
BUILDER_GOAL_RECOVERY_REQUIRE_SIGNED_MANIFEST=true
# Server-owned artifact/staging root for sanitized logs, proposals, and validated candidates.
BUILDER_GOAL_RECOVERY_ARTIFACT_ROOT=data/compile-recovery-artifacts
# Server-owned Micro6 source reference; recovery never accepts caller-supplied roots or targets.
BUILDER_GOAL_RECOVERY_MICRO6_PROJECT_DIR=C:\Dev\IdeaProjects\micro6

# SC-1664 target-owned input lifecycle. Linux attachment is fail-closed and disabled by default.
# When enabling the proof of concept, set either this application root (which must contain
# native\linux-x86_64\libRemoteInput.so plus its manifest) or CHROMASCAPE_REMOTEINPUT_LIBRARY.
CHROMASCAPE_REMOTEINPUT_ATTACHMENT_ENABLED=false
CHROMASCAPE_REMOTEINPUT_APPLICATION_ROOT=C:\Dev\IdeaProjects\ChromaScape
CHROMASCAPE_REMOTEINPUT_LIBRARY=
