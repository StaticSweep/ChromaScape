# Copy to .env.fedora.local. The local file is git-ignored.
# All paths must be absolute host-native Fedora paths, never Flatpak/bwrap paths.
BUILDER_GOAL_MICRO6_PROJECT_DIR=/absolute/path/to/micro6
BUILDER_GOAL_LAUNCHER_LOCAL_MACHINE_UUID=
JAVA_HOME=/absolute/path/to/jdk-17

# SC-1667 host-native runtime. Loopback is the safe development default.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8090
CHROMASCAPE_FEDORA_STARTUP_TIMEOUT_SECONDS=900
CHROMASCAPE_FEDORA_STOP_TIMEOUT_SECONDS=30
# Optional local override; defaults to .chromascape/fedora under this checkout.
CHROMASCAPE_FEDORA_STATE_DIR=

# The wrapper supplies these loopback defaults when they are unset. Override only
# when this Fedora host is deliberately connected to those trusted services.
LEEUWBOT_STREAM_URL=ws://127.0.0.1:8084/ws/screens/agent
LEEUWBOT_STREAM_HOST_ID=fedora-host-native
BUILDER_GOAL_LAUNCHER_BASE_URL=http://127.0.0.1:8084
BUILDER_GOAL_ACCOUNT_CATALOG_BASE_URL=http://127.0.0.1:8092
CHROMASCAPE_PATCHLOOP_MICRO6_EXECUTOR_BASE_URL=http://127.0.0.1:8098
MICRO6_EXECUTOR_BASE_URL=http://127.0.0.1:8098
GAMEPLAY_BOOTSTRAP_MICRO6_URL=http://127.0.0.1:8098
LEEUWBOT_CANDIDATE_REGISTRY_URL=http://127.0.0.1:8081

# Linux RemoteInput stays fail-closed. When enabled, supply either the application
# root containing native/linux-x86_64 or the exact absolute library path.
CHROMASCAPE_REMOTEINPUT_ATTACHMENT_ENABLED=false
CHROMASCAPE_REMOTEINPUT_APPLICATION_ROOT=/absolute/path/to/ChromaScape/build/dist
CHROMASCAPE_REMOTEINPUT_LIBRARY=

# A strict interactive preflight requires one eligible client by default when
# attachment is enabled. Set false only to start ChromaScape before RuneLite/Micro6.
CHROMASCAPE_FEDORA_REQUIRE_TARGET=true
CHROMASCAPE_FEDORA_TARGET_PID=
