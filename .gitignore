# Java class files
*.class

# Log files (including archived ones -- *.log does not match *.log.gz)
*.log
*.log.gz

# Runtime log artifact accidentally named with a Windows-style variable
/%log%

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.ear

# Virtual machine crash logs
hs_err_pid*
*.hprof

# Generated files
bin/
!third_party/KInput/KInput/KInput/bin/
!third_party/KInput/KInput/KInputCtrl/bin/
out/
build/
!third_party/minhook/build/

# Gradle cache and wrappers
.gradle/
/.gradle-home/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA
.idea/
*.iml
*.iws

# VS Code
.vscode/

# Eclipse
*.classpath
*.project
*.settings/

# OS-specific
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*~
/javac.*.args
/app_yml_*.patch

# Local task diagnostics
/.sc810-debug/

# Templates
/src/main/resources/fonts/
/src/main/resources/images/ui/
/src/main/resources/images/user/*
!/src/main/resources/images/user/.gitkeep

# output
output/*
!output/.gitkeep

# chromascape runtime cache
.chromascape/

# Local Felix indexes
/.felix.*.db
/.felix.*.db-shm
/.felix.*.db-wal

# custom user scripts
/src/main/java/com/chromascape/scripts/*/
/scripts/*/

# Local environment configuration (machine-specific, never commit)
/.env
/.env.local
/.env.*.local
!/.env.example

# recordings
recordings/

# SC-1661 baseline-validation evidence is deliberately tracked: each file below was
# reviewed for credentials/account identifiers before being retained. Scoped negation
# only -- this must not unignore *.log anywhere else in the repository.
!docs/upstream-integration/sc-1661/evidence/*.log
