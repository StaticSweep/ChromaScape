# Java class files
*.class

# Log files (including archived ones -- *.log does not match *.log.gz)
*.log
*.log.gz

# Runtime log artifact accidentally named with a Windows-style variable
/%log%

# Local review and diagnostic scratch files
/.tmp_*
/checkenv-tmp.ps1
/jstack_*.txt
/jstack_out.txt

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.ear

# Virtual machine crash logs
hs_err_pid*
*.hprof

# Generated files
bin/
!third_party/KInput/KInput/KInput/bin/
!third_party/KInput/KInput/KInputCtrl/bin/
out/
build/
!third_party/minhook/build/

# Python bytecode (SC-1662 helper/test scripts)
__pycache__/
*.pyc

# Gradle cache and wrappers
.gradle/
/.gradle-home/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA
.idea/
*.iml
*.iws

# VS Code
.vscode/

# Eclipse
*.classpath
*.project
*.settings/

# OS-specific
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*~
/javac.*.args
/app_yml_*.patch

# Local task diagnostics
/.sc810-debug/

# Templates
/src/main/resources/fonts/
/src/main/resources/images/ui/
/src/main/resources/images/user/*
!/src/main/resources/images/user/.gitkeep

# output
output/*
!output/.gitkeep

# chromascape runtime cache
.chromascape/

# Local Felix indexes
/.felix.*.db
/.felix.*.db-shm
/.felix.*.db-wal

# SC-1662 local launcher environment (machine-specific, never commit)
/scripts/sc1662-env.sh

# custom user scripts
/src/main/java/com/chromascape/scripts/*/
/scripts/*/

# Local environment configuration (machine-specific, never commit)
/.env
/.env.local
/.env.*.local
!/.env.example

# recordings
recordings/

# Node DOM test dependencies
/node_modules/

# SC-1661 baseline-validation evidence is deliberately tracked: each file below was
# reviewed for credentials/account identifiers before being retained. Scoped negation
# only -- this must not unignore *.log anywhere else in the repository.
!docs/upstream-integration/sc-1661/evidence/*.log

# SC-1662 native build tooling is deliberately tracked. `/scripts/*/` above excludes a
# directory, and git never descends into an excluded directory, so the directory itself has to be
# re-included before anything inside it can be tracked. Re-including the directory exposes
# everything below it, so its contents are excluded again and only the reviewed files are named
# explicitly. Scoped to the reviewed files -- this must not unignore scripts/*, user scripts, or
# any file added to scripts/native/ later without review.
!/scripts/native/
/scripts/native/*
!/scripts/native/build-remoteinput-linux.sh
!/scripts/native/remoteinput_metadata.py
!/scripts/native/staging-regressions.sh
!/scripts/native/staging-shell-regressions.sh
!/scripts/native/distribution-exclusion-regressions.sh
!/scripts/native/diagnose-remoteinput-linux.sh
!/scripts/native/sc1668_failure_identities.py
!/scripts/native/tests/
/scripts/native/tests/*
!/scripts/native/tests/test_remoteinput_metadata.py
!/scripts/native/tests/staging_regression_fixtures.py
!/scripts/native/tests/diagnose-remoteinput-linux-regressions.sh
!/scripts/native/tests/remoteinput-linux-window-selection-regressions.sh

# SC-1667 reviewed Fedora host-native startup/preflight tooling. Keep the broad
# user-script ignore above; only these named files are part of the product contract.
!/scripts/fedora/
/scripts/fedora/*
!/scripts/fedora/chromascape-fedora.sh
!/scripts/fedora/package-distribution.sh
!/scripts/fedora/build-rpm.sh
!/scripts/fedora/install-tarball.sh
!/scripts/fedora/uninstall-tarball.sh
!/scripts/fedora/certify-packaged.sh
!/scripts/fedora/certify-live-recording-debugger.sh
!/scripts/fedora/lib/
/scripts/fedora/lib/*
!/scripts/fedora/lib/preflight.sh
!/scripts/fedora/lib/packaging.sh
!/scripts/fedora/tests/
/scripts/fedora/tests/*
!/scripts/fedora/tests/preflight-regressions.sh
!/scripts/fedora/tests/packaging-regressions.sh
!/scripts/fedora/tests/live-recording-debugger-regressions.sh

# SC-1668 reviewed cross-host evidence tooling. Records generated by operators remain outside the
# repository unless they are deliberately redacted and added under the story evidence directory.
!/scripts/qualification/
/scripts/qualification/*
!/scripts/qualification/__init__.py
!/scripts/qualification/sc1668_evidence.py
!/scripts/qualification/fedora02_evidence.py
!/scripts/qualification/fedora03_evidence.py
!/scripts/qualification/ws_probe.py
!/scripts/qualification/tests/
/scripts/qualification/tests/*
!/scripts/qualification/tests/__init__.py
!/scripts/qualification/tests/test_sc1668_evidence.py
!/scripts/qualification/tests/test_fedora02_evidence.py
!/scripts/qualification/tests/test_fedora03_evidence.py
!/scripts/qualification/tests/test_ws_probe.py

# SC-1662 reviewed evidence is deliberately tracked: each log below was reviewed for
# credentials/account identifiers before being retained. Scoped negation only -- this must
# not unignore *.log anywhere else in the repository, and must not cover build outputs.
!docs/upstream-integration/sc-1662/evidence/*.log
!docs/upstream-integration/sc-1662/evidence/r6-distribution-tree.txt
!docs/upstream-integration/sc-1662/evidence/r6-container-identity.txt
